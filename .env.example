# Base de dados
DATABASE_URL=postgres://globalacademy:globalacademy@localhost:5432/globalacademy
# true cria/atualiza tabelas automaticamente (usar só em desenvolvimento ou no 1.º arranque)
DB_SYNC=true
# Nº máx. de ligações do nosso processo à base de dados. Em produção com um pooler (ex.: Supabase
# Supavisor/PgBouncer) mantenha isto baixo (3-5) para não esgotar o limite de ligações do plano.
DB_POOL_MAX=5

# Autenticação do painel (gerar com: openssl rand -base64 48)
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ADMIN_EMAIL=admin@globalacademy.local
ADMIN_PASSWORD=ChangeMe123!

# Uploads de imagens feitos no painel: com UPLOADTHING_TOKEN preenchido, o painel usa o
# UploadThing (arrastar e largar, vários ficheiros de uma vez); sem ele, usa UPLOAD_DIR no disco local.
UPLOAD_DIR=./uploads
UPLOADTHING_TOKEN=

SITE_URL=http://localhost:3000

# Pagamentos AppyPay (as mesmas credenciais do site institucional).
# Sem estes valores, as inscrições ficam "pendentes" com as instruções manuais do método de pagamento.
# Webhook a configurar no AppyPay: {SITE_URL}/api/payments/appypay/callback
GATEWAY_API_URL=https://gwy-api.appypay.co.ao/v2.0
APPY_CLIENT_ID=
APPY_CLIENT_SECRET=
APPY_RESOURCE=
APPYPAY_GPO_ID=
APPYPAY_REF_ID=
APPYPAY_MERCHANT_IDENTIFIER=
APPYPAY_API_KEY=

# Email (Resend). Sem estes valores, os formulários funcionam mas não enviam email.
# O domínio do remetente tem de estar verificado no Resend.
RESEND_API_KEY=
EMAIL_FROM="Academia GSC <academia@gservicescorporation.com>"